# Copy to .env and adjust. Everything is optional; unset values fall back to
# the defaults documented in vm/README.md.

# Release-built image tag from ghcr.io/xinlong-wu/ssct-dsh.
DSH_IMAGE_TAG=latest

# Model credentials forwarded into the guest service.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# Guest sizing.
DSH_VM_CPUS=4
DSH_VM_MEMORY_MB=4096
DSH_VM_DISK_GB=40

# Ports published on the host (loopback only in this compose file).
DSH_VM_WEB_PORT=10240
DSH_VM_SSH_PORT=2222

# Mount sources for the read-only config and skills shares.
DSH_CONFIG_HOST=./config
DSH_SKILLS_HOST=./skills

# Reuse your own SSH key instead of the generated one. When set, also add the
# volume mount shown in the comment inside vm/compose.yaml.
#DSH_VM_SSH_KEY=$HOME/.ssh/id_ed25519

# Pin the guest base image for reproducible provisioning (recommended).
#VM_IMAGE_URL=https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img
#VM_IMAGE_SHA256=

# Set to 1 to discard the guest overlay and reprovision on the next boot.
FORCE_REPROVISION=0
